<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ViewFlipper android:id="@+id/flip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:autoStart="true" android:flipInterval="700">
                <ImageView android:id="@+id/f0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="center" android:contentDescription="Tadpole"/>
                <ImageView android:id="@+id/f1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="center" android:contentDescription="Tadpole"/>
            </ViewFlipper>
            <ImageView android:id="@+id/info" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:scaleType="center" android:contentDescription="Tadpole status"/>
            <FrameLayout android:layout_width="36dp" android:layout_height="match_parent">
                <ImageView android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="center" android:contentDescription="Refresh"/>
                <ProgressBar android:id="@+id/spin" android:layout_width="80px" android:layout_height="80px" android:layout_gravity="center" android:visibility="gone"
                    android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/spin_anim" android:indeterminateDuration="760"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:orientation="horizontal">
            <ImageView android:id="@+id/input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="center" android:contentDescription="Type an entry"/>
            <ImageView android:id="@+id/b_stool" android:layout_width="38dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:scaleType="center" android:contentDescription="Stool quality"/>
            <ImageView android:id="@+id/b_neuro" android:layout_width="38dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:scaleType="center" android:contentDescription="Neuroinflammation"/>
            <ImageView android:id="@+id/b_meal" android:layout_width="38dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:scaleType="center" android:contentDescription="Meal"/>
            <ImageView android:id="@+id/b_clear" android:layout_width="38dp" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:scaleType="center" android:contentDescription="No symptoms"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
